{
  "schemaVersion": 1,
  "id": "bvr.github-actions",
  "name": "GitHub Actions",
  "version": "0.1.0",
  "author": "BVR Code",
  "license": "MIT",
  "description": "GitHub Actions workflows for your repositories in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "GitHub Actions",
    "description": "See running and last workflow runs per repository, and trigger workflows.",
    "category": "Development",
    "aliases": [
      "github",
      "ci",
      "workflows"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalMinutes": 5
    },
    "schema": [
      {
        "key": "refreshIntervalMinutes",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
